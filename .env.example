# Copy this file to .env.local and fill in your own values.
# Never commit .env.local — it's already in .gitignore.

# --- Supabase ---
# Create a free project at https://supabase.com, then:
# 1. Run supabase/schema.sql in the SQL editor.
# 2. Get these values from Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — server-only, NEVER expose this to the browser or commit it.
# Used by src/app/api/pins to validate + insert new pins server-side.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site ---
# Used for absolute URLs in Open Graph/share links. Set to your real
# domain once deployed (e.g. https://globalkindnessmap.org).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Ads (optional) ---
# Set this once your site is approved for Google AdSense, to enable
# real ad units. Leave unset during development.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
