# Copy this file to .env.local and fill in your own values.
# Never commit .env.local — it's already in .gitignore.
#
# The app runs without any of this: with no Supabase credentials it falls
# back to a built-in set of sample stories (clearly labelled in the UI) so
# every screen is explorable straight after `git clone`.

# --- Supabase ---
# Create a free project at https://supabase.com, then:
# 1. Run supabase/schema.sql in the SQL editor.
# 2. Get these values from Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — server-only, NEVER expose this to the browser or commit it.
# Used by src/app/api/pins to validate + insert new pins server-side.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site ---
# Used for absolute URLs in Open Graph/share links. Set to your real
# domain once deployed (e.g. https://globalkindnessmap.org).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shown as the "Source" link in the footer.
NEXT_PUBLIC_GITHUB_URL=

# Optional. When set, a quiet "support this project" panel appears on the
# About page and a link in the footer. Leave BLANK on a fork unless it
# points at your own account.
NEXT_PUBLIC_SUPPORT_URL=

# --- Atlas / country stats (optional) ---
# New pins are reverse-geocoded once, at submission time, to an ISO country
# code for the /atlas breakdown. It uses OpenStreetMap's Nominatim, is
# best-effort (a failure never blocks a pin), and is cached in memory.
# Set to "off" to disable the outbound lookup entirely — pins are then
# stored without a country and counted as "unplaced" in the Atlas.
REVERSE_GEOCODE=

# --- Content moderation (optional) ---
# Without a key, submissions are screened by a local word-list filter only.
# With one, they also get context-aware screening, which catches a
# politely-worded threat and stops tripping over words like "Scunthorpe".
#
# Set EITHER of these. Gemini wins if both are present.
# Screening fails OPEN — if the provider is unreachable the local filter
# still runs and people can still post.

# Gemini (recommended): free tier, no billing setup needed.
# Key from https://aistudio.google.com/api-keys
GEMINI_API_KEY=
# Optional override; defaults to gemini-flash-lite-latest.
GEMINI_MODERATION_MODEL=

# OpenAI: the Moderation endpoint bills no tokens, but the account still
# needs billing configured or every call returns 429.
OPENAI_API_KEY=
# Optional override; defaults to omni-moderation-latest.
OPENAI_MODERATION_MODEL=

# --- Ads (optional) ---
# Both are required before any ad unit renders. Set them once your site is
# approved for Google AdSense; leave unset during development.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_ID=
